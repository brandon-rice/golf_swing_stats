# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.

# --- Local Postgres target ---
# Either set a single URL...
# LOCAL_DB_URL=postgresql://postgres:postgres@localhost:5432/brdb
# ...or the split keys below (LOCAL_DB_URL wins if both are set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brdb
DB_USER=postgres
DB_PASSWORD=
# Schema that holds the golf tables (default: golf_swing_stats):
DB_SCHEMA=golf_swing_stats

# --- Neon Postgres (cloud publish target; optional, not yet wired) ---
NEON_DB_URL=postgresql://USER:PASSWORD@HOST.neon.tech/golf_swing_stats?sslmode=require

# --- Where SkyTrak CSV exports live ---
# One or more folders, separated by `;` on Windows (`:` on macOS/Linux). Every
# folder is scanned in one pass, and both export generations are accepted:
# the legacy `Export_ShotsHistory_*.csv` and the current `activity-*.csv`.
SWING_DATA_DIRS=C:/path/to/old_exports;C:/path/to/new_exports

# Single-folder alias, still honored (and merged with SWING_DATA_DIRS if both are set):
# SWING_DATA_DIR=
